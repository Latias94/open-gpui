{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThemeJsonSchemaFile",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1,
      "maximum": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "mode": {
      "$ref": "#/$defs/ThemeJsonMode"
    },
    "revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "colors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ThemeJsonColorEntry"
      },
      "minItems": 28,
      "maxItems": 28
    },
    "design": {
      "$ref": "#/$defs/ThemeJsonDesignScales"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "label",
    "mode",
    "revision",
    "colors",
    "design"
  ],
  "$defs": {
    "ThemeJsonMode": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "high-contrast"
      ]
    },
    "ThemeJsonColorEntry": {
      "type": "object",
      "properties": {
        "token": {
          "$ref": "#/$defs/ThemeJsonToken"
        },
        "state": {
          "$ref": "#/$defs/ThemeJsonColorState"
        },
        "rgb": {
          "type": "string",
          "pattern": "^#?[0-9A-Fa-f]{6}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "token",
        "state",
        "rgb"
      ]
    },
    "ThemeJsonToken": {
      "type": "string",
      "enum": [
        "semantic.surface",
        "semantic.surface_muted",
        "semantic.border",
        "semantic.text",
        "semantic.text_muted",
        "semantic.accent",
        "semantic.accent_foreground",
        "semantic.focus_ring",
        "semantic.destructive",
        "semantic.destructive_foreground",
        "semantic.overlay",
        "semantic.modal_overlay"
      ]
    },
    "ThemeJsonColorState": {
      "type": "string",
      "enum": [
        "default",
        "hover",
        "selected",
        "disabled",
        "read-only",
        "invalid",
        "required",
        "placeholder",
        "message",
        "focus-visible",
        "overlay",
        "modal-overlay"
      ]
    },
    "ThemeJsonDesignScales": {
      "type": "object",
      "properties": {
        "typography": {
          "$ref": "#/$defs/ThemeJsonTypographyScale"
        },
        "spacing": {
          "$ref": "#/$defs/ThemeJsonSpacingScale"
        },
        "radius": {
          "$ref": "#/$defs/ThemeJsonRadiusScale"
        },
        "elevation": {
          "$ref": "#/$defs/ThemeJsonElevationScale"
        },
        "density": {
          "$ref": "#/$defs/ThemeJsonDensity"
        },
        "motion_policy": {
          "$ref": "#/$defs/ThemeJsonMotionPolicy"
        }
      },
      "additionalProperties": false,
      "required": [
        "typography",
        "spacing",
        "radius",
        "elevation",
        "density",
        "motion_policy"
      ]
    },
    "ThemeJsonTypographyScale": {
      "type": "object",
      "properties": {
        "control_text": {
          "$ref": "#/$defs/ThemeJsonSizeScale"
        },
        "control_line_height": {
          "$ref": "#/$defs/ThemeJsonSizeScale"
        }
      },
      "additionalProperties": false,
      "required": [
        "control_text",
        "control_line_height"
      ]
    },
    "ThemeJsonSizeScale": {
      "type": "object",
      "properties": {
        "xsmall": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "small": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "medium": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "large": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "additionalProperties": false,
      "required": [
        "xsmall",
        "small",
        "medium",
        "large"
      ]
    },
    "ThemeJsonSpacingScale": {
      "type": "object",
      "properties": {
        "control_inline": {
          "$ref": "#/$defs/ThemeJsonSizeScale"
        },
        "control_block": {
          "$ref": "#/$defs/ThemeJsonSizeScale"
        }
      },
      "additionalProperties": false,
      "required": [
        "control_inline",
        "control_block"
      ]
    },
    "ThemeJsonRadiusScale": {
      "type": "object",
      "properties": {
        "control": {
          "$ref": "#/$defs/ThemeJsonSizeScale"
        }
      },
      "additionalProperties": false,
      "required": [
        "control"
      ]
    },
    "ThemeJsonElevationScale": {
      "type": "object",
      "properties": {
        "overlay": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThemeJsonElevationLayer"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "overlay"
      ]
    },
    "ThemeJsonElevationLayer": {
      "type": "object",
      "properties": {
        "offset_x": {
          "type": "integer",
          "format": "int16",
          "minimum": -32768,
          "maximum": 32767
        },
        "offset_y": {
          "type": "integer",
          "format": "int16",
          "minimum": -32768,
          "maximum": 32767
        },
        "blur_radius": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "spread_radius": {
          "type": "integer",
          "format": "int16",
          "minimum": -32768,
          "maximum": 32767
        },
        "opacity_percent": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "required": [
        "offset_x",
        "offset_y",
        "blur_radius",
        "spread_radius",
        "opacity_percent"
      ]
    },
    "ThemeJsonDensity": {
      "type": "string",
      "enum": [
        "compact",
        "comfortable",
        "spacious"
      ]
    },
    "ThemeJsonMotionPolicy": {
      "type": "string",
      "enum": [
        "animated",
        "reduced"
      ]
    }
  }
}
